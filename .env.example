DISCORD_TOKEN=
ADMIN_IDS=1210291131301101618
ADMIN_ROLE_ID=1376177459870961694
DATABASE_PATH=vexdeploy.db
LXD_NETWORK=vexdeploy
LXD_CLI=
LXD_STORAGE=
DEFAULT_OS_IMAGE=ubuntu:22.04
MAX_CONTAINERS=100
MAX_VPS_PER_USER=3
DEFAULT_MEMORY_MB=1024
DEFAULT_CPUS=1
DEFAULT_DISK_GB=10
# Plans: name:memory_mb:cpus:disk_gb[:badge[:price]]  (comma-separated)
PLANS=Starter:1024:1:10:Free,Pro:2048:2:25:Popular:$4,Business:4096:4:50:Best

# AI (Google Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Mention-chat: anyone can @mention the bot (per-user cooldown seconds)
AI_CHAT_ENABLED=1
AI_CHAT_COOLDOWN=30
AI_CHAT_TIMEOUT=25
# Verification: DM questions + trust report after VPS creation (report-only)
AI_VERIFICATION_ENABLED=1
VERIFICATION_TIMEOUT=600
# Trust role names (auto-created if missing; needs Manage Roles)
TRUSTED_ROLE_NAME=Trusted
UNTRUSTED_ROLE_NAME=Untrusted
SCAMMER_ROLE_NAME=Scammer
SPAMMER_ROLE_NAME=Spammer
